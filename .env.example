# Copy this file to .env and fill in ONE provider. Never commit .env.

# Free option for demos (get a key at console.groq.com/keys):
LLM_PROVIDER=groq
LLM_API_KEY=



# Paid Claude option for client sites (key from console.anthropic.com):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Other choices: LLM_PROVIDER=openrouter or gemini (with LLM_API_KEY),
# or custom (also set LLM_BASE_URL and LLM_MODEL).
# Optional: LLM_MODEL=... to change the model of any provider.

# ---- AI assistant (api/chat.js). Fill ONE provider. ----
# Free option for demos (key from console.groq.com/keys):
LLM_PROVIDER=groq
LLM_API_KEY=
# Paid Claude option for client sites:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Optional: LLM_MODEL=... to change the model of any provider.

# ---- Site address, set on Vercel for SEO (no trailing slash) ----
# VITE_SITE_URL=https://yourname.com
